#     ___    _________
#    /   |  /  _/ ___/  __    __
#   / /| |  / / \__ \__/ /___/ /_
#  / ___ |_/ / ___/ /_  __/_  __/
# /_/  |_/___//____/ /_/   /_/
#
#
# AISI file — Phase-Shear Readout, phase space grid mode
#
# Same MZ / PSR geometry as PSR_EXAMPLE_NLMT1.aisi (T = 2.225 s, n = 1,
# kx_PSR = 3140 rad/m) but initialised with a Cartesian phase space grid
# rather than a Gaussian ensemble.
#
# Grid: 25 x 25 points in (x, vx), all other dims fixed.
#   x   : -300 um  to  +300 um  (covers ±3σ for σ_x = 100 um)
#   vx  : -0.93 mm/s to +0.93 mm/s  (covers ±3σ for T_trans = 1 nK)
#   y, z: fixed at 0
#   vy  : fixed at 0
#   vz  : fixed at 19.62 m/s (launch velocity)
#
# Total atoms simulated: 25 × 25 = 625  (one per grid node, ~0.5 s runtime)
#
# Output: a _PSMAP.h5 file with initial/final positions+velocities and
# complex amplitudes for every wavepacket, ready for offline cloud averaging
# in aispy — see example_psgrid.ipynb.
#
# Run with:
#   ais++ -i PSR_EXAMPLE_PSGRID.aisi -o output-files/PSR_EXAMPLE_PSGRID.h5

# Init mode
initmode psgrid

# Phase space grid  (format: min  max  n_points)
xgrid  -0.0003  0.0003  25
ygrid   0.0     0.0      1
zgrid   0.0     0.0      1
vxgrid -0.00093 0.00093 25
vygrid  0.0     0.0      1
vzgrid  19.62   19.62    1

# Cloud parameters (required by parser; ignored in psgrid mode)
natoms 1
initialstate 0
sigma 0.0001
transtemp 1e-09
longtemp 0
x0 0.0 0.0 0.0
v0 0 0.0 19.62

# Potential parameters
utype linear_pot

# Simulation parameters
amplitudethreshold 0
coherencelength 3.740463112189228e-06
usemcbranching 0
usepathselection 1
usestaticapprox 0
ultrafast 1
pathstosimulate 0010 0011 0100 0101
ignoredetuning 0
seed -1
usedetvolselection 0
xdet -0.03 0.03
ydet -0.03 0.03
zdet -0.03 0.03
gslqagabserr 1e-12
gslqagrelerr 1e-12
gslkinodeabserr 1e-09
gslkinoderelerr 0
gslpulseodeabserr 1e-09
gslpulseoderelerr 0

# Sequence parameters
detectiontime 4.451

# IO parameters — not used in psgrid mode (WritePhaseSpaceMapToFile is called instead)
printprobs 0
printwavepackets 0

# Pulse parameters  (identical to PSR_EXAMPLE_NLMT1.aisi)
t0 0.0 2.22525 4.45075
t1 0.00025 2.22575 4.451
kx 0.0 0.0 3140.0
ky 0.0 0.0 0.0
kz 8995954.348315687495500094725385411 8995953.759474347513950220782899023 8995953.03814248313063203347609048
omega 2696919266137348.114235837336956127 2696919069758342.430517432843378587 2696918873357302.771955712409335449
rabifreq 1000.0 1000.0 1000.0
wtype gaussian gaussian gaussian
phi0 0 0 0
kxchirp 0 0 0
kychirp 0 0 0
kzchirp 0 0 0
frequencychirp 0 0 0
waist 0.01000319328186729550325188260259019 0.01000319328186729550325188260259019 0.01000319328186729550325188260259019
focallength 0 0 0
zlaser 0 0 0
beamradius 0.02 0.02 0.02
baseline 10 10 10
