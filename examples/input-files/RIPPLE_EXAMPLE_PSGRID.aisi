# AISI file - wtype "ripple" example, phase-space grid mode
# Three-pulse MZ at Omega/2pi = 1 kHz (pi/2 250 us, dark 20 us, pi 500 us, dark 20 us, pi/2 250 us),
# uniform intensity, transverse phase phi = 0.1 cos(2 pi x / 4 um), all pulses up-going, zero gravity.
# Run:  ais++ -i RIPPLE_EXAMPLE_PSGRID.aisi -o out.h5     (writes the PSMAP datasets to out.h5)
natoms 1
initialstate 0
sigma 0
transtemp 0
longtemp 0
x0 0 0 0.0
v0 0 0 0.0
utype zero_pot
amplitudethreshold 0
coherencelength 0.001
usemcbranching 0
usepathselection 1
usestaticapprox 0
ultrafast 1
pathstosimulate 0010 0100 0011 0101
ignoredetuning 0
seed -1
usedetvolselection 0
xdet -1 1
ydet -1 1
zdet -1 1
gslqagabserr 1e-12
gslqagrelerr 1e-12
gslkinodeabserr 1e-09
gslkinoderelerr 0
gslpulseodeabserr 1e-09
gslpulseoderelerr 0
detectiontime 0.001041
printprobs 0
printwavepackets 0
